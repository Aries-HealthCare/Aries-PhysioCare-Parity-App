# Aries PhysioCare Website — environment variables (BACK-012)
# Copy to .env.local for local development. Do not commit secrets.

# Server-side backend API base (preferred for production deployments)
BACKEND_API_BASE_URL=https://api.ariesxpert.com/api/v1

# Alternative public env vars (also used by lead API config)
NEXT_PUBLIC_API_URL=https://api.ariesxpert.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.ariesxpert.com/api/v1

# Local development: when all backend URL vars are unset, therapist proxy defaults to:
# http://localhost:5001/api/v1

# Lead ingestion (server-only — never use NEXT_PUBLIC_ for this secret)
# LEAD_INGEST_SECRET=

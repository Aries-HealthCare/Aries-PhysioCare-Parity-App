# Aries PhysioCare Parity App — environment variables
# Copy to .env.local for local development. Do not commit secrets.

# Backend origin. An `/api` or `/api/v1` suffix is tolerated and stripped —
# `getBackendOrigin()` normalises it, because the app builds mobile-shaped paths
# (`/api/app/...`, `/api/admin/...`, `/api/v1/...`) on top of the bare origin.
# This is also the Socket.io origin the real-time provider connects to.
BACKEND_API_BASE_URL=https://api.ariesxpert.com
NEXT_PUBLIC_API_URL=https://api.ariesxpert.com
NEXT_PUBLIC_API_BASE_URL=https://api.ariesxpert.com

# Local development against a locally running backend:
# BACKEND_API_BASE_URL=http://localhost:5001

# Build metadata shown in the account sidebar.
NEXT_PUBLIC_APP_VERSION=2.0.0-parity

# Public site domains (no secrets)
NEXT_PUBLIC_MAIN_DOMAIN=ariesphysiocare.com
NEXT_PUBLIC_APP_DOMAIN=app.ariesphysiocare.com
